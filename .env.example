# ---- App login (copy this file to .env and fill in) ----
BASE_URL=https://connle.telecmi.com/
EMAIL=
PASSWORD=
ACCOUNT_ID=33336085

# ---- AI provider: you need only ONE (or none, with AI_HEAL_USE_LLM=false) ----
AI_PROVIDERS=groq,openrouter,ollama,anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Self-healing ----
AI_HEAL=true
AI_HEAL_USE_LLM=true
AI_HEAL_AUTOPATCH=false
AI_HEAL_PROBE_TIMEOUT_MS=8000

# ---- Writer agent ----
AI_AGENT_USE_LLM=true             # false = offline rule-based filler only (no API key needed)
AI_AGENT_REPLAN=false             # true = ignore the saved plan and plan again
AI_HEAL_MAX_LLM_CALLS=3           # max AI calls the healer may make per test run (token saver)
AI_HEAL_MISS_TTL_MIN=60           # remember "AI found nothing" for this many minutes
